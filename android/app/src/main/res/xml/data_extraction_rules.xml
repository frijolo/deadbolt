<?xml version="1.0" encoding="utf-8"?>
<!--
  Hard opt-out from both Android Auto Backup (Google Drive) and device-to-device
  transfer. Deadbolt holds encrypted wallet .db files plus a plaintext
  .wallet_key file under appSupport — none of it should leave the device via
  OS-level backup mechanisms. Users do all backup/restore explicitly through
  the in-app export / Nostr-backup flows.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root"/>
        <exclude domain="file"/>
        <exclude domain="database"/>
        <exclude domain="sharedpref"/>
        <exclude domain="external"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="root"/>
        <exclude domain="file"/>
        <exclude domain="database"/>
        <exclude domain="sharedpref"/>
        <exclude domain="external"/>
    </device-transfer>
</data-extraction-rules>
